# Environment
NODE_ENV=development
PORT=3000
API_PREFIX=api

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/intercity?schema=public
SHADOW_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/intercity_shadow?schema=public

# Test DB (docker-compose.test.yml)
DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:5434/intercity_test?schema=public
SHADOW_DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:5434/intercity_shadow?schema=public

# Redis
REDIS_URL=redis://localhost:6379
REDIS_URL_TEST=redis://localhost:6380
BULL_PREFIX=intercity

# Auth / JWT
JWT_ACCESS_SECRET=CHANGE_ME_ACCESS_SECRET_32CHARS
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH_SECRET_32CHARS
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_DOMAIN=
SUPERADMIN_PHONE=+998944692509
SUPERADMIN_PASSWORD=bekk2006
SUPERADMIN_IMMUTABLE=true
BOOTSTRAP_SUPERADMIN_PHONE=
BOOTSTRAP_SUPERADMIN_PASSWORD=

# CORS
CORS_DISABLED=false
# In non-production CORS is allow-all by default. Set true to enforce CORS_ORIGIN even on localhost.
CORS_STRICT_LOCAL=false
CORS_ORIGIN=http://localhost:3100,http://localhost:5173,http://localhost:8081,http://127.0.0.1:3100,http://127.0.0.1:5173,http://127.0.0.1:8081

# Rate limits
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=200
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_AUTH_LOGIN_MAX=10
RATE_LIMIT_ADMIN_MAX=300
RATE_LIMIT_DISABLE_LOCAL=true
LOGIN_LOCK_MAX_ATTEMPTS=5
LOGIN_LOCK_WINDOW_SEC=600

# Logging / observability
LOG_LEVEL=info
SWAGGER_ENABLED=true
REALTIME_ENABLED=false
METRICS_ENABLED=true
GEO_MAX_UPDATES_PER_SEC=5
GEO_RETENTION_ENABLED=true
GEO_RETENTION_CRON=0 3 * * *
GEO_LOCATION_RETENTION_DAYS=30
GEO_RETENTION_LOCK_SEC=300

# Sentry
SENTRY_ENABLED=true
SENTRY_DSN=
SENTRY_ENV=development
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0

# Business rules
BOOKING_CANCEL_FEE_PERCENT=10
OFFERS_MAX_DRIVER=3
OFFERS_MAX_PASSENGER=3

# Routing
ROUTING_PROVIDER=mock
OSRM_BASE_URL=http://localhost:5000

# Payments
PAYMENT_PROVIDER=click
PAYMENT_WEBHOOK_SECRET=CHANGE_ME_WEBHOOK_SECRET
CLICK_WEBHOOK_SECRET=
PAYME_WEBHOOK_SECRET=
STRIPE_WEBHOOK_SECRET=
PAYMENT_RECONCILE_ENABLED=true
PAYMENT_RECONCILE_CRON=*/10 * * * *
PAYMENT_RECONCILE_STALE_MINUTES=60
PAYMENT_RECONCILE_BATCH=200
PAYMENT_RECONCILE_LOCK_SEC=120
MIGRATION_LOCK_KEY=87234123
MIGRATION_LOCK_TIMEOUT_SEC=60

# Telegram notifications
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Environment
NODE_ENV=development
PORT=3000
API_PREFIX=api

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/intercity?schema=public
SHADOW_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/intercity_shadow?schema=public

# Test DB (docker-compose.test.yml)
DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:5434/intercity_test?schema=public
SHADOW_DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:5434/intercity_shadow?schema=public

# Redis
REDIS_URL=redis://localhost:6379
REDIS_URL_TEST=redis://localhost:6380
BULL_PREFIX=intercity

# Auth / JWT
JWT_ACCESS_SECRET=CHANGE_ME_ACCESS_SECRET_32CHARS
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH_SECRET_32CHARS
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# CORS
CORS_ORIGIN=http://localhost:5173

# Rate limits
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=200
RATE_LIMIT_AUTH_MAX=20

# Logging / observability
LOG_LEVEL=info
SWAGGER_ENABLED=true
REALTIME_ENABLED=false
METRICS_ENABLED=true

# Sentry
SENTRY_ENABLED=true
SENTRY_DSN=
SENTRY_ENV=development
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0

# Business rules
BOOKING_CANCEL_FEE_PERCENT=10
OFFERS_MAX_DRIVER=3
OFFERS_MAX_PASSENGER=3

# Shared platform environment
# Backend API
API_BASE_URL=http://localhost:3000

# Admin web
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Intercity Admin

# Mobile (Expo)
# Android emulator: http://10.0.2.2:3000
# iOS simulator: http://127.0.0.1:3000
# Physical device: http://<LAN_IP>:3000
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:3000
# Optional fallback for real device when EXPO_PUBLIC_API_BASE_URL uses 10.0.2.2
EXPO_PUBLIC_API_BASE_URL_LAN=http://192.168.1.100:3000
EXPO_PUBLIC_ENABLE_LOCATION=true
EXPO_PUBLIC_ENABLE_PUSH=true
EXPO_PUBLIC_ENABLE_MOCKS=false
EXPO_PUBLIC_SENTRY_DSN=
SENTRY_RELEASE=

# Optional
OPENAPI_SOURCE=../docs/openapi.json

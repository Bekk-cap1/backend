{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@platform/shared": ["packages/shared/src/index.ts"],
      "@platform/shared/*": ["packages/shared/src/*"],
      "@platform/api-client": ["packages/api-client/src/index.ts"],
      "@platform/api-client/*": ["packages/api-client/src/*"],
      "@platform/ui": ["packages/ui/src/index.ts"],
      "@platform/ui/*": ["packages/ui/src/*"],
      "@platform/config/*": ["packages/config/*"]
    }
  }
}
